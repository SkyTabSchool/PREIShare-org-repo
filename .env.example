# .env.example — commit this file. Never put real keys here.
# Copy to .env for local development and fill in values from
# Supabase → Project Settings → API.
# Names and rules: docs/sponsor-auth-requirements.md (section 7)
# Review sheet: docs/env-var-checklist.md
#
# Vite’s public prefix is VITE_. Only those names may reach browser code
# via import.meta.env. Server code reads process.env, including names
# without a VITE_ prefix.
#
# PUBLIC (safe in the browser when Row Level Security is on)
# Do not put the service-role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY (no VITE_ prefix; never import in browser code)
# Optional copy of the same project URL for server code.
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret. Bypasses Row Level Security. process.env on the server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

EMBEDDING_API_KEY=your-embedding-api-key